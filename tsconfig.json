{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@rules": ["./supabase/functions/_shared/rules.ts"],
      "@board": ["./content/board.json"]
    }
  },
  "include": ["src", "supabase/functions/_shared/rules.ts", "supabase/functions/_shared/rules.test.ts", "vite.config.ts"]
}
